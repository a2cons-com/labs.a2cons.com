---
// A browser-style frame around a desktop screenshot.
import type { Shot } from '../data/shots';

interface Props {
  shot: Shot;
  url?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { shot, url, eager = false, sizes = '(max-width: 1080px) 100vw, 50vw', class: cls } = Astro.props;
---

<figure class:list={['window', cls]}>
  <div class="window-bar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    {url && <span class="window-url">{url}</span>}
  </div>
  <img
    src={shot.src}
    srcset={shot.srcset}
    sizes={sizes}
    alt={shot.alt}
    width={shot.w}
    height={shot.h}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</figure>

---
// A product render that turns into an interactive 3D view on request.
// three.js and the model load only after "View in 3D" is pressed, so the
// page never waits for them.
interface Props {
  model: string;
  poster: string;
  posterSrcset?: string;
  alt: string;
  width: number;
  height: number;
}
const { model, poster, posterSrcset, alt, width, height } = Astro.props;
---

<div class="model-viewer" data-model={model}>
  <img class="model-poster" src={poster} srcset={posterSrcset} sizes="(max-width: 820px) 60vw, 360px" alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  <button type="button" class="model-btn" data-model-open>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7z" /><path d="m3 7 9 5 9-5M12 12v10" /></svg>
    <span data-model-label>View in 3D</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.model-viewer').forEach((box) => {
    const button = box.querySelector<HTMLButtonElement>('[data-model-open]')!;
    const label = box.querySelector<HTMLElement>('[data-model-label]')!;
    button.addEventListener('click', async () => {
      button.disabled = true;
      label.textContent = 'Loading 3D…';
      try {
        const { show } = await import('../lib/viewer');
        await show(box, box.dataset.model!);
        box.classList.add('is-3d');
        button.remove();
      } catch {
        label.textContent = 'Couldn’t load the 3D view';
      }
    });
  });
</script>

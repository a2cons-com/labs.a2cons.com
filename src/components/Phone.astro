---
// A phone frame around a mobile screenshot.
import type { Shot } from '../data/shots';

interface Props {
  shot: Shot;
  eager?: boolean;
  class?: string;
}
const { shot, eager = false, class: cls } = Astro.props;
---

<figure class:list={['phone', cls]}>
  <span class="phone-notch" aria-hidden="true"></span>
  <img src={shot.src} srcset={shot.srcset} sizes="(max-width: 640px) 45vw, 240px" alt={shot.alt} width={shot.w} height={shot.h} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</figure>

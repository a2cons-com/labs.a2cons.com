---
// App Store and Google Play badges (official artwork) with QR codes, per app.
// The QR codes hide on phones: you can't scan your own screen.
interface Props {
  app?: 'contracts' | 'calc';
}
const { app = 'contracts' } = Astro.props;

const apple = { name: 'App Store', badge: '/badges/app-store.svg', alt: 'Download on the App Store', w: 120 };
const google = { name: 'Google Play', badge: '/badges/google-play.png', alt: 'Get it on Google Play', w: 134 };
const apps = {
  contracts: {
    title: 'A2 Contracts',
    stores: [
      { ...apple, url: 'https://apps.apple.com/us/app/a2-contracts/id6811957673', qr: '/badges/qr-app-store.svg' },
      { ...google, url: 'https://play.google.com/store/apps/details?id=com.a2cons.contracts', qr: '/badges/qr-google-play.svg' },
    ],
  },
  calc: {
    title: 'A2 Calc',
    stores: [
      { ...apple, url: 'https://apps.apple.com/app/id6831422602', qr: '/badges/qr-calc-app-store.svg' },
      { ...google, url: 'https://play.google.com/store/apps/details?id=com.a2cons.calc', qr: '/badges/qr-calc-google-play.svg' },
    ],
  },
};
const { title, stores } = apps[app];
---

<div class="stores">
  {stores.map((s) => (
    <a class="store" href={s.url} target="_blank" rel="noopener">
      <img class="store-qr" src={s.qr} alt={`QR code for ${title} on ${s.name}`} width="88" height="88" loading="lazy" />
      <img class="store-badge" src={s.badge} alt={s.alt} width={s.w} height="40" loading="lazy" />
    </a>
  ))}
</div>

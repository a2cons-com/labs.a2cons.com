---
import '@fontsource-variable/archivo';
import '../styles/global.css';
import { site } from '../data/site';
import { services } from '../data/services';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Breadcrumb label for a service page; also marks the page as a Service in JSON-LD. */
  crumb?: string;
  /** Parent page for a third-level breadcrumb. */
  parent?: { name: string; href: string };
  /** Share image name in public/og/ (defaults to the service page's, else home). */
  og?: string;
  preload?: { href: string; type: string }[];
}
const {
  title,
  description = 'A2 Labs builds custom web and mobile software and offers engineering services, computer networking research, and finance and accounting for small businesses. Based in Miami, Florida.',
  crumb,
  parent,
  og,
  preload = [],
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Software, engineering and research in Miami`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const page = Astro.url.pathname.replace(/\//g, '');
const slug = og ?? (services.some((s) => s.id === page) ? page : 'home');
const ogImage = new URL(`/og/${slug}.jpg`, Astro.site);
const path = Astro.url.pathname;
const orgId = new URL('/#organization', Astro.site).toString();

const graph: Record<string, unknown>[] = [
  {
    '@type': 'ProfessionalService',
    '@id': orgId,
    name: site.name,
    legalName: site.legalName,
    url: new URL('/', Astro.site).toString(),
    logo: new URL('/img/a2-mark.svg', Astro.site).toString(),
    image: new URL('/og/home.jpg', Astro.site).toString(),
    description: 'Custom web and mobile software, engineering services, computer networking research, and finance and accounting for small businesses.',
    address: { '@type': 'PostalAddress', addressLocality: 'Miami', addressRegion: 'FL', addressCountry: 'US' },
    areaServed: 'US',
    knowsAbout: ['Software development', 'Mobile apps', 'Named Data Networking', 'Information-centric networking', 'Internet of Things', 'Engineering design', 'Bookkeeping', 'QuickBooks Online', 'Payroll'],
    parentOrganization: { '@type': 'Organization', name: 'A2 Construction', url: 'https://a2cons.com' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, description: s.summary, url: new URL(s.href, Astro.site).toString() },
      })),
    },
  },
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
    name: site.name,
    url: new URL('/', Astro.site).toString(),
    publisher: { '@id': orgId },
  },
];
if (crumb && title) {
  graph.push(
    { '@type': 'Service', name: title, description, url: canonical.toString(), provider: { '@id': orgId }, areaServed: 'US' },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Home', item: new URL('/', Astro.site).toString() },
        ...(parent ? [{ name: parent.name, item: new URL(parent.href, Astro.site).toString() }] : []),
        { name: crumb, item: canonical.toString() },
      ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
    },
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#15181b" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    {preload.map((p) => <link rel="preload" as="image" href={p.href} type={p.type} fetchpriority="high" />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar" data-topbar>
      <div class="wrap topbar-row">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <img class="mark" src="/img/a2-mark.svg" alt="" width="85" height="36" />
          <span class="brand-name">Labs</span>
        </a>
        <nav class="topnav" aria-label="Services">
          {services.map((s) => <a href={s.href} aria-current={path.startsWith(s.href) ? 'page' : undefined}>{s.nav}</a>)}
        </nav>
        <a class="btn btn-green btn-sm top-cta" href="#contact">Contact</a>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-about">
          <span class="foot-brand"><img src="/img/a2-mark.svg" alt="" width="47" height="20" />Labs</span>
          <p>Software, engineering, networking research and finance services from the team behind A2 Construction and A2 Contracts.</p>
        </div>
        <div>
          <h2>Services</h2>
          <ul>
            {services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Products</h2>
          <ul>
            <li><a href="https://contracts.a2cons.com" target="_blank" rel="noopener">A2 Contracts</a></li>
            <li><a href="/software/">A2 QBO</a></li>
            <li><a href="/software/">BI Inventory</a></li>
          </ul>
        </div>
        <div>
          <h2>Contact</h2>
          <ul>
            <li><a href="#message">Send us a message</a></li>
            <li>{site.city}</li>
          </ul>
        </div>
        <p class="foot-fine">
          © {site.copyrightYear} {site.legalName}. {site.name} is a trade name of {site.legalName}. A sister company of <a href="https://a2cons.com" target="_blank" rel="noopener">A2 Construction</a>.
          Professional engineering services in Florida are offered by <a href={site.engineeringUrl} target="_blank" rel="noopener">{site.engineeringBy}</a>,
          {site.engineerReg}. QuickBooks is a trademark of Intuit Inc.; A2 QBO is not affiliated with or endorsed by Intuit.
        </p>
      </div>
    </footer>

    <script>
      // Shadow under the top bar once the page scrolls; sections fade in once.
      const bar = document.querySelector('[data-topbar]');
      const onScroll = () => bar?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

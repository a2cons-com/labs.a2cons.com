---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Window from '../components/Window.astro';
import Phone from '../components/Phone.astro';
import Backdrop from '../components/Backdrop.astro';
import Showcase from '../components/Showcase.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { shots } from '../data/shots';

const more = [
  {
    href: '/web/',
    eyebrow: 'Web design',
    title: 'Websites that load fast and get found.',
    body: 'Sites for businesses and organizations, quick on a phone and easy for search engines and AI assistants to read.',
    image: undefined,
    site: 'a2cons',
  },
  {
    href: '/engineering/',
    eyebrow: 'Engineering services',
    title: 'Practical engineering, from the idea to the drawing.',
    body: 'Technical design, analysis, drawings and 3D models, and systems integration for projects that need an engineer’s eye.',
    image: 'workbench',
    site: undefined,
  },
  {
    href: '/research/',
    eyebrow: 'Networking research',
    title: 'An Internet built around data, not addresses.',
    body: 'More than a decade of Named Data Networking research, and the open-source code behind it, from a UCLA computer science Ph.D.',
    image: 'packets',
    site: undefined,
  },
  {
    href: '/finance/',
    eyebrow: 'Finance & accounting',
    title: 'Books you can trust, and numbers you can read.',
    body: 'Bookkeeping, monthly close, QuickBooks Online cleanup, payroll and tax-ready books, reviewed with our own software.',
    image: undefined,
    site: undefined,
  },
];

const steps = [
  ['Talk', 'A short call about what you need and what you have today.'],
  ['Scope', 'A written plan with what we will deliver, when, and for how much.'],
  ['Build', 'Regular check-ins and working results early, not one big reveal.'],
  ['Hand over', 'Documentation, training and support after the work is done.'],
];
---

<Base preload={[{ href: '/img/hero-network-1672.avif', type: 'image/avif' }]}>
  <main id="top">
    <section class="hero">
      <Backdrop name="hero-network" eager position="right top" />
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="wrap hero-row">
        <div class="hero-copy">
          <p class="eyebrow on-dark">A2 Labs · {site.city}</p>
          <h1>Software, engineering and research <span class="accent">that hold up in the real world.</span></h1>
          <p class="lead">
            Custom web and mobile software, engineering design and computer networking research, plus the finance side of a
            business, from a small team that builds and runs its own tools every day.
          </p>
          <div class="cta-row">
            <a class="btn btn-green" href="#software">See what we’ve built <Icon name="arrow" size={18} /></a>
            <a class="btn btn-ghost" href="#services">Our services</a>
          </div>
        </div>
        <div class="hero-art">
          <Window class="hero-window" shot={shots.qboHero} url="A2 QBO" eager sizes="(max-width: 1080px) 100vw, 50vw" />
          <Phone class="hero-phone" shot={shots.contractsPhone} eager />
          <div class="hero-chip chip-books" aria-hidden="true">
            <span class="chip-icon"><Icon name="phone" size={16} /></span>
            <span><strong>Web, iPhone, Android</strong><small>one codebase, works offline</small></span>
          </div>
          <div class="hero-chip chip-net" aria-hidden="true">
            <span class="chip-icon"><Icon name="network" size={16} /></span>
            <span><strong>/labs/data/v3</strong><small>named, signed, verified</small></span>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap services" id="services" aria-label="Services">
      {services.map((s) => (
        <a class="service-card reveal" href={s.href}>
          <span class="service-icon"><Icon name={s.icon} size={24} /></span>
          <h2>{s.title}</h2>
          <p>{s.summary}</p>
          <span class="service-more">Learn more <Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </section>

    <section class="section band-white" id="software">
      <div class="wrap">
        <div class="center-head reveal">
          <p class="eyebrow">Software development</p>
          <h2 class="section-title">We build software we use every day.</h2>
          <p class="section-lead">
            Every product below runs a real business: a construction company, a bookkeeping practice and a hospitality
            operation. Yours could be next, whether it’s a web app, an iPhone and Android app, or AI that works with your data.
          </p>
        </div>
        <Showcase />
        <p class="center-link reveal"><a class="text-link" href="/software/">More about our software work <Icon name="arrow" size={16} /></a></p>
      </div>
    </section>

    <section class="section">
      <div class="wrap more-grid">
        {more.map((m) => (
          <a class="more-card reveal" href={m.href}>
            <div class="more-art">
              {m.image ? (
                <picture>
                  <source type="image/avif" srcset={`/img/${m.image}-960.avif`} />
                  <img src={`/img/${m.image}-960.webp`} alt="" width="960" height="540" loading="lazy" decoding="async" />
                </picture>
              ) : m.site ? (
                <img src={`/web/${m.site}-800.webp`} alt="A2 Construction website home page" width="800" height="500" loading="lazy" decoding="async" class="more-shot" />
              ) : (
                <img src="/shots/qbo-cash-1280.webp" alt={shots.qboChart.alt} width="1280" height="800" loading="lazy" decoding="async" class="more-shot" />
              )}
            </div>
            <div class="more-copy">
              <p class="eyebrow">{m.eyebrow}</p>
              <h2>{m.title}</h2>
              <p>{m.body}</p>
              <span class="service-more">Learn more <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section section-tight" aria-labelledby="how-title">
      <div class="wrap">
        <div class="center-head reveal">
          <p class="eyebrow">How we work</p>
          <h2 class="section-title" id="how-title">Small team, straight answers.</h2>
        </div>
        <ol class="steps reveal">
          {steps.map(([t, b], i) => (
            <li>
              <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t}</h3>
              <p>{b}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <ContactBlock />
  </main>
</Base>

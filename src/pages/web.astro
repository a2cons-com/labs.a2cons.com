---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { portfolio } from '../data/portfolio';

const how = [
  ['Fast everywhere', 'Static pages, modern image formats and no heavy scripts, so a site opens quickly on a phone with one bar of signal.'],
  ['Found in search', 'Clean structure, structured data, sitemaps and share previews, so Google, Bing and AI assistants describe you correctly.'],
  ['Cheap to run', 'Hosted on GitHub Pages or your own server for next to nothing, with HTTPS and automatic deploys.'],
  ['Yours to keep', 'Your content in plain files under your control, not locked into a page-builder subscription.'],
];
---

<Base
  title="Web design"
  description="Web design and development from A2 Labs in Miami: fast, search-friendly websites for businesses and organizations. Portfolio: A2 Construction, Turnpike Electric, Sadler Farms, NDNComm and more."
  crumb="Web design"
>
  <main>
    <PageHero
      image="hero-network"
      position="right top"
      eyebrow="Web design"
      title="Websites that load fast and get found."
      lead="We design and build websites for businesses and organizations: quick on a phone, easy for search engines and AI assistants to read, and cheap to run."
    />

    <section class="section">
      <div class="wrap">
        <div class="center-head reveal">
          <p class="eyebrow">Our work</p>
          <h2 class="section-title">Sites we designed and built.</h2>
        </div>
        <div class="sites">
          {portfolio.map((p) => (
            <article class="site-card reveal">
              <a class="site-art" href={p.url} target="_blank" rel="noopener" aria-label={`${p.name} (opens the site)`}>
                <figure class="window">
                  <div class="window-bar" aria-hidden="true">
                    <span class="dots"><i></i><i></i><i></i></span>
                    <span class="window-url">{p.url.replace('https://', '')}</span>
                  </div>
                  <img
                    src={`/web/${p.id}-800.webp`}
                    srcset={`/web/${p.id}-800.webp 800w, /web/${p.id}.webp 1440w`}
                    sizes="(max-width: 820px) 100vw, 45vw"
                    alt={`${p.name} website home page`}
                    width="1440"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <figure class="phone site-phone">
                  <span class="phone-notch" aria-hidden="true"></span>
                  <img src={`/web/${p.id}-phone.webp`} alt={`${p.name} website on a phone`} width="400" height="866" loading="lazy" decoding="async" />
                </figure>
              </a>
              <div class="site-copy">
                <span class="product-tag">{p.kind}</span>
                <h3>{p.name}</h3>
                <p>{p.body}</p>
                <a class="text-link" href={p.url} target="_blank" rel="noopener">{p.url.replace('https://', '')} <Icon name="arrow" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-tight band-white">
      <div class="wrap">
        <div class="center-head reveal">
          <p class="eyebrow">How we build them</p>
          <h2 class="section-title">Good-looking, and built properly underneath.</h2>
        </div>
        <div class="cards-auto reveal">
          {how.map(([t, b]) => (
            <div class="light-card tall">
              <h3>{t}</h3>
              <p>{b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContactBlock topic="Web design" />
  </main>
</Base>

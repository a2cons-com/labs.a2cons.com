---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <main class="hero" style="min-height: 70vh; display: grid; place-items: center;">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap" style="position: relative; text-align: center;">
      <p class="eyebrow on-dark">404</p>
      <h1>This page isn’t here.</h1>
      <div class="cta-row" style="justify-content: center;"><a class="btn btn-green" href="/">Back to the home page</a></div>
    </div>
  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ModelViewer from '../components/ModelViewer.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';

const lines = [
  {
    no: '01',
    title: 'MEP engineering',
    body: 'Mechanical, electrical and plumbing engineering calculations and construction documents for permit submittal. Work is drafted to match the project’s architectural plans, and modeled in 3D/BIM where it helps coordinate systems or communicate design intent. When a plan reviewer returns comments, revisions are handled directly, without routing back and forth through another firm.',
    items: ['Load calculations', 'Permit-ready construction documents', 'System coordination & drafting', 'Plan-review revisions'],
  },
  {
    no: '02',
    title: 'MOT / public-works plans',
    body: 'Maintenance-of-traffic (MOT) plans for work that extends into the public right-of-way, prepared to the standards public-works permitting departments expect for lane, sidewalk and driveway closures, and drafted to match the scope of work and the reviewing municipality’s requirements.',
    items: ['Lane & road closures', 'Sidewalk & driveway work', 'Right-of-way permitting plans', 'Municipal plan-review support'],
  },
  {
    no: '03',
    title: 'Custom prototype modeling & fabrication',
    body: 'Parts, enclosures and assemblies modeled in 3D from a sketch, a broken original or an idea, then 3D-printed so you can test fit and function before committing to production. Files are handed over ready for printing, machining or a manufacturer.',
    items: ['3D modeling of parts & assemblies', '3D printing of prototypes', 'Fit & function iterations', 'Production-ready files'],
  },
];
---

<Base
  title="Engineering services"
  description="MEP engineering and MOT / public-works plans in Florida (through A2 Construction, FL Eng. Reg. #40202), plus custom prototype modeling and 3D-printed fabrication from A2 Labs in Miami."
  crumb="Engineering"
>
  <main>
    <PageHero
      image="workbench"
      position="right center"
      eyebrow="Engineering services"
      title="Engineering for permits, and prototypes you can hold."
      lead={`MEP engineering and public-works permitting plans, carried from calculations through permit approval by the engineer who prepared them, through our sister company ${site.engineeringBy} (${site.engineerReg}). And custom parts modeled in 3D and printed.`}
    />

    <section class="section band-blueprint">
      <div class="wrap split reverse">
        <div class="split-art reveal">
          <div class="eng-art">
            <img class="eng-drawing" src="/img/jalousie-drawing-960.webp" alt="" width="960" height="623" loading="lazy" decoding="async" />
            <ModelViewer
              model="/models/jalousie.glb"
              poster="/img/jalousie-render-600.webp"
              posterSrcset="/img/jalousie-render-400.webp 400w, /img/jalousie-render-600.webp 600w"
              alt="3D model of a historical jalousie window we modeled for fabrication: aluminum frame and seventeen blades"
              width={600}
              height={1408}
            />
          </div>
          <p class="eng-caption">A historical jalousie window, modeled in 3D and drawn for fabrication.</p>
        </div>
        <div class="split-copy reveal">
          <p class="eyebrow">What we do</p>
          <h2 class="section-title">From the calculations to the approved permit.</h2>
          <p class="section-lead">
            For homeowners, contractors and architects in Florida: the engineering a permit set calls for, and the revisions
            the plan reviewer asks for, from one engineer.
          </p>
          <p class="pe-note">
            MEP engineering and MOT plans are professional engineering services provided by
            <a href={site.engineeringUrl} target="_blank" rel="noopener">{site.engineeringBy}</a>, {site.engineerReg}.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap eng-lines">
        {lines.map((l) => (
          <article class="eng-line reveal">
            <span class="step-no">{l.no}</span>
            <h2>{l.title}</h2>
            <p>{l.body}</p>
            <ul class="mini-list">
              {l.items.map((i) => <li><Icon name="check" size={16} />{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <ContactBlock topic="Engineering" />
  </main>
</Base>
